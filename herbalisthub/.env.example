# HerbalistHub Environment Variables
# Copy this file to .env.local and fill in your actual values
# NEVER commit actual .env files to version control

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
# MySQL Database URL for Prisma
# Format: mysql://username:password@localhost:3306/database_name
DATABASE_URL="mysql://herbalist_user:herbalist_password@localhost:3306/herbalisthub_dev"

# Test database (optional, for running tests)
TEST_DATABASE_URL="mysql://herbalist_user:herbalist_password@localhost:3306/herbalisthub_test"

# ===================================================================
# NEXTAUTH.JS CONFIGURATION
# ===================================================================
# NextAuth.js secret key (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-key-here-must-be-32-characters"

# Application URL (change for production)
NEXTAUTH_URL="http://localhost:3000"

# ===================================================================
# OAUTH PROVIDERS
# ===================================================================
# Google OAuth (get from: https://console.developers.google.com)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===================================================================
# EMAIL SERVICE CONFIGURATION
# ===================================================================
# SMTP Configuration for sending emails (reminders, notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="HerbalistHub <noreply@herbalisthub.com>"

# SendGrid API Key (alternative to SMTP)
SENDGRID_API_KEY="SG.your-sendgrid-api-key"

# ===================================================================
# AWS SERVICES CONFIGURATION
# ===================================================================
# AWS Credentials (for S3 file storage, SES email, etc.)
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"

# S3 Bucket for file storage (images, documents)
AWS_S3_BUCKET="herbalisthub-files"
AWS_S3_REGION="us-east-1"

# ===================================================================
# GOOGLE SERVICES
# ===================================================================
# Google Calendar API (for appointment sync)
GOOGLE_CALENDAR_API_KEY="your-google-calendar-api-key"

# Google Analytics (optional)
GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# ===================================================================
# PAYMENT PROCESSING (Future implementation)
# ===================================================================
# Stripe (for future payment processing)
STRIPE_PUBLIC_KEY="pk_test_your-stripe-public-key"
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# ===================================================================
# ENCRYPTION & SECURITY
# ===================================================================
# Field-level encryption key for PHI data (generate with: openssl rand -base64 32)
ENCRYPTION_KEY="your-32-character-encryption-key-for-phi-data"

# JWT Secret for API authentication (generate with: openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-key-for-api-authentication"

# Password hashing salt rounds (recommended: 12-14)
BCRYPT_SALT_ROUNDS="12"

# ===================================================================
# EXTERNAL API INTEGRATIONS
# ===================================================================
# Zoom API (for virtual appointments)
ZOOM_API_KEY="your-zoom-api-key"
ZOOM_API_SECRET="your-zoom-api-secret"

# Twilio (for SMS notifications)
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# ===================================================================
# APPLICATION SETTINGS
# ===================================================================
# Environment (development, staging, production)
NODE_ENV="development"

# Application name and version
APP_NAME="HerbalistHub"
APP_VERSION="1.0.0"

# Default timezone
DEFAULT_TIMEZONE="America/New_York"

# Maximum file upload size (in bytes)
MAX_FILE_SIZE="10485760" # 10MB

# Session timeout (in seconds)
SESSION_TIMEOUT="86400" # 24 hours

# ===================================================================
# MONITORING & LOGGING
# ===================================================================
# Sentry DSN (for error tracking)
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# Log level (error, warn, info, debug)
LOG_LEVEL="info"

# ===================================================================
# REDIS CONFIGURATION (Optional)
# ===================================================================
# Redis URL for caching and session storage
REDIS_URL="redis://localhost:6379"

# ===================================================================
# FEATURE FLAGS
# ===================================================================
# Enable/disable features
ENABLE_GOOGLE_CALENDAR_SYNC="true"
ENABLE_EMAIL_REMINDERS="true"
ENABLE_SMS_NOTIFICATIONS="false"
ENABLE_FILE_UPLOADS="true"
ENABLE_AUDIT_LOGGING="true"

# ===================================================================
# DEVELOPMENT ONLY
# ===================================================================
# Database seeding (development only)
SEED_DATABASE="false"

# Enable debug mode
DEBUG="false"

# Prisma Studio (development only)
PRISMA_STUDIO_PORT="5555"